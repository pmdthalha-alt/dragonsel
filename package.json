{
  "name": "dragonsel",
  "version": "1.0.0",
  "description": "Dragonsel is an all-in-one AI creation workspace for research, writing, design, video, websites, apps, games, and export.",
  "main": "app.js",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "start": "vite --host 127.0.0.1 --port 5173",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "check": "node --check app.js && node --check smoke-test.mjs",
    "smoke": "node smoke-test.mjs http://127.0.0.1:5173",
    "setup": "npm install && npm run setup:backend && npm run setup:frontend",
    "setup:backend": "cd backend && npm install",
    "setup:frontend": "cd frontend && npm install",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "docker:up": "docker-compose up",
    "docker:down": "docker-compose down",
    "test": "npm run check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pmdthalha-alt/dragonsel.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/pmdthalha-alt/dragonsel/issues"
  },
  "homepage": "https://github.com/pmdthalha-alt/dragonsel#readme",
  "devDependencies": {
    "playwright": "^1.59.1",
    "vite": "^8.0.10"
  }
}
